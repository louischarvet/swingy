<configuration>
    <!-- Désactive les logs pour Hibernate Validator -->
    <logger name="org.hibernate.validator" level="WARN"/>
    <!-- Optionnel : Désactive aussi les logs pour Jakarta Bean Validation -->
    <logger name="jakarta.validation" level="WARN"/>
    <!-- Configuration de base pour la console -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>